{
	"name": "agent-workbench-gateway",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"ratelimits": [
		{
			"name": "CHAT_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 5,
				"period": 60
			}
		}
	],
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "agent-workbench-docs",
			"remote": true
		}
	],
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"d1_databases": [
		{
			"binding": "agent_workbench_metrics",
			"database_name": "agent-workbench-metrics",
			"database_id": "7c02597a-764a-4342-89eb-5f5a2dd3774d"
		}
	]
}